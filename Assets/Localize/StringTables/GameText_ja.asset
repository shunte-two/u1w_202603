  - m_Id: 1000000000004
    m_Localized: "\u5BB9\u7591\u8005\u306E\u884C\u52D5\u306F\u4E0D\u5BE9\u306B\u898B\u3048\u308B\u304C\u3001\u307E\u3060\u65AD\u5B9A\u306F\u65E9\u3044\u3002"
