    m_Localized: "\u6B21\u306F\u30AB\u30FC\u30C9\u306E\u89E3\u91C8\u53CD\u8EE2\u3084\u6642\u7CFB\u5217\u6574\u7406\u306B\u7E4B\u304C\u308B\u64CD\u4F5C\u3092\u5DEE\u3057\u8FBC\u3081\u308B\u72B6\u614B\u306B\u306A\u3063\u305F\u3002"
